{
  "name": "jira-oauth-client",
  "version": "0.1.0",
  "description": "Jira OAuth 2.0 (3LO) client — authenticate, refresh, and store tokens for use in VS Code extensions, scripts, and CLI tools",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test tests/e2e/flow.e2e.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "^4.18.2",
    "open": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "cspell": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "husky": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongitran/jira-oauth-client.git"
  },
  "keywords": ["jira", "atlassian", "oauth", "oauth2", "authentication", "token", "vscode"],
  "author": "dongitran",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "^0.4.1"
    }
  }
}
